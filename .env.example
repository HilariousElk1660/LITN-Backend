# Example environment variables (do NOT commit real secrets)
# Set your real values in a secure .env file or environment injection mechanism.

DATABASE_URL=postgres://<user>:<pass>@<host>/<db>
JWT_SECRET=replace_with_your_jwt_secret

# Cloudinary (used for uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret

# Airtel (placeholder)
AIRTEL_API_URL=https://api.airtel.example/payment/v1/merchant/transactions
AIRTEL_API_KEY=your_airtel_api_key_here
AIRTEL_CALLBACK_SECRET=your_airtel_callback_secret_here

# CurrencyAPI (do NOT paste your real key into version control).
# Sign up at https://app.currencyapi.net and set the key in your environment.
# Example (set locally or in your deployment environment):
# export CURRENCY_API_KEY=f009db76d8df4775613881bad44ba4d56270
CURRENCY_API_KEY=your_currencyapi_key_here
CURRENCY_API_URL=https://api.currencyapi.net/v3/latest
CURRENCY_CACHE_TTL=3600
